---
import BaseLayout from '../layouts/BaseLayout.astro';
import GalleryLightbox from '../components/GalleryLightbox.astro';
import { getAvailableWorks } from '../data/squareArtworks';

export const prerender = false;

const { works: availableWorks, error } = await getAvailableWorks();
---

<BaseLayout
  title="Available Works"
  description="Original paintings by Joana Antunes currently available for purchase enquiries."
>
  <header class="page-mast available-mast">
    <div class="container available-mast__inner">
      <h1 class="heading-xl available-mast__title">Available Works</h1>
      <div class="divider" aria-hidden="true"></div>
    </div>
  </header>

  <section class="section section--tight available-section">
    <div class="container">
      {
        availableWorks.length > 0 ? (
          <div class="available__grid">
            {availableWorks.map((artwork, index) => (
              <article class="available-card">
                <button
                  type="button"
                  class="available-card__image image-frame"
                  data-lightbox-index={index}
                  aria-label={`View ${artwork.title} full screen`}
                >
                  <img src={artwork.image} alt={`${artwork.title} by Joana Antunes`} loading="lazy" />
                </button>
                <div class="available-card__body">
                  <h2 class="available-card__title">{artwork.title}</h2>
                  <dl class="available-card__details">
                    {artwork.medium && (
                      <div>
                        <dt>Medium</dt>
                        <dd>{artwork.medium}</dd>
                      </div>
                    )}
                    {artwork.dimensions && (
                      <div>
                        <dt>Dimensions</dt>
                        <dd>{artwork.dimensions}</dd>
                      </div>
                    )}
                    {artwork.price && (
                      <div>
                        <dt>Price</dt>
                        <dd>{artwork.price}</dd>
                      </div>
                    )}
                  </dl>
                  <div class="available-card__actions">
                    <button type="button" class="available-card__buy" disabled>Buy Original</button>
                    <button
                      type="button"
                      class="available-card__enquire"
                      data-lightbox-index={index}
                      aria-label={`Enquire about ${artwork.title}`}
                    >
                      Enquire
                    </button>
                  </div>
                </div>
              </article>
            ))}
          </div>
        ) : (
          <div class="available-empty">
            <p class="eyebrow">Currently unavailable</p>
            <h2 class="heading-md">No original paintings are available right now.</h2>
            <p>
              New work will be added here when it becomes available. For commissions or
              future availability, please get in touch.
            </p>
            {error && <p class="available-empty__note">Availability could not be refreshed just now.</p>}
          </div>
        )
      }
    </div>
  </section>

  <section class="section section--tight purchasing-section" aria-labelledby="purchasing-delivery-title">
    <div class="container purchasing-section__inner">
      <h2 class="heading-sm" id="purchasing-delivery-title">Purchasing &amp; Delivery</h2>
      <div class="purchasing-section__copy">
        <p>All original paintings are sold unframed unless otherwise stated.</p>
        <p>
          If you would prefer your painting framed, please get in touch to discuss the
          available options and any additional costs.
        </p>
        <p>
          Each painting is carefully packaged for shipping. Please allow additional time for
          preparation and delivery, particularly for international orders. Shipping costs are
          calculated separately.
        </p>
      </div>
    </div>
  </section>

  <GalleryLightbox works={availableWorks} enquiryLabel="Inquire about this piece" />
</BaseLayout>

<style>
  .available-mast {
    padding-block: clamp(3.25rem, 8vw, 6rem) clamp(2.25rem, 5vw, 3.25rem);
  }

  .available-mast__inner {
    max-width: 54rem;
  }

  .available-mast__title {
    font-size: clamp(2.85rem, 6vw, 4.5rem);
  }

  .available-mast .divider {
    margin-block: 1.2rem 0;
  }

  .available-mast .lead {
    margin-inline: auto;
  }

  .available-section {
    padding-top: clamp(2.5rem, 6vw, 4rem);
  }

  .available__grid {
    display: grid;
    gap: clamp(3rem, 6vw, 5rem) clamp(1.5rem, 3vw, 2.5rem);
  }

  .available-card {
    display: grid;
    gap: 1.5rem;
  }

  .available-card__image {
    width: 100%;
    border: none;
    padding: 0;
    background: none;
    cursor: pointer;
    aspect-ratio: 4 / 5;
  }

  .available-card__image img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .available-card__body {
    display: grid;
    gap: 0.9rem;
    border-top: 1px solid var(--color-border);
    padding-top: 1rem;
  }

  .available-card__title {
    font-family: var(--font-display);
    font-size: clamp(1.55rem, 3vw, 2rem);
    font-weight: 400;
    line-height: 1.15;
  }

  .available-card__details {
    display: grid;
    gap: 0.35rem;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: 1.65;
  }

  .available-card__details div {
    display: flex;
    gap: 0.5rem;
  }

  .available-card__details dt {
    color: var(--color-text-faint);
  }

  .available-card__details dd {
    margin: 0;
  }

  .available-card__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.35rem;
  }

  .available-card__buy,
  .available-card__enquire {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.6rem;
    padding: 0.7rem 1rem;
    border: 1px solid var(--color-border-strong);
    background: transparent;
    color: var(--color-accent);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
  }

  .available-card__buy {
    opacity: 0.48;
    cursor: not-allowed;
  }

  .available-card__enquire {
    cursor: pointer;
    transition:
      background var(--transition),
      color var(--transition);
  }

  .available-card__enquire:hover,
  .available-card__enquire:focus-visible {
    background: var(--color-accent);
    color: var(--color-bg-elevated);
  }

  .available-empty {
    max-width: 40rem;
    margin-inline: auto;
    text-align: center;
    color: var(--color-text-muted);
  }

  .available-empty .heading-md {
    margin-top: 0.9rem;
    color: var(--color-text);
  }

  .available-empty p:not(.eyebrow) {
    margin-top: 1rem;
    line-height: var(--leading-body);
  }

  .available-empty__note {
    color: var(--color-text-faint);
    font-size: var(--text-sm);
  }

  .purchasing-section {
    padding-top: 0;
  }

  .purchasing-section__inner {
    max-width: 46rem;
    border-top: 1px solid var(--color-border);
    padding-top: clamp(2rem, 5vw, 3rem);
  }

  .purchasing-section .heading-sm {
    margin: 0;
    font-size: clamp(1.35rem, 3vw, 1.75rem);
    font-weight: 400;
  }

  .purchasing-section__copy {
    display: grid;
    gap: 0.9rem;
    margin-top: 1.1rem;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-body);
  }

  .purchasing-section__copy p {
    margin: 0;
  }

  @media (min-width: 700px) {
    .available__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1100px) {
    .available__grid {
      grid-template-columns: repeat(3, 1fr);
      column-gap: clamp(2rem, 4vw, 3rem);
    }
  }

  @media (max-width: 640px) {
    .available-card__actions {
      flex-direction: column;
    }

    .available-card__buy,
    .available-card__enquire {
      width: 100%;
    }
  }
</style>
