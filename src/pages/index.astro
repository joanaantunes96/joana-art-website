---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArtworkCard from '../components/ArtworkCard.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';
import { featuredWorks, heroImage } from '../data/artworks';
---

<BaseLayout title="Home">
  <section class="hero">
    <div class="hero__inner container">
      <figure class="hero__figure image-frame">
        <img
          src={heroImage}
          alt="Featured contemporary artwork by Joana Antunes"
          width="1080"
          height="810"
          fetchpriority="high"
        />
      </figure>
      <div class="hero__content">
        <h1 class="hero__statement">Contemporary Fine Art</h1>
        <div class="divider hero__rule" aria-hidden="true"></div>
        <p class="lead hero__lead">
          Original oil paintings inspired by the beauty found in the natural world.
        </p>
        <p class="lead hero__lead">
          A collection of work shaped by light, atmosphere, and the moments that feel
          worth holding onto.
        </p>
        <div class="hero__actions">
          <a href="/gallery" class="btn">View Gallery</a>
          <a href="/about" class="link-underline hero__secondary">The Artist</a>
        </div>
      </div>
    </div>
  </section>

  <section class="artist-intro section">
    <div class="container artist-intro__inner">
      <div class="artist-intro__heading">
        <p class="eyebrow">The Artist</p>
        <h2 class="heading-lg">Joana Antunes</h2>
      </div>
      <div class="artist-intro__copy">
        <p>
          Born in Portugal and now based in Devon, UK, Joana creates original oil
          paintings inspired by the natural world, from landscapes and still lifes to
          portraiture.
        </p>
        <p>
          Working primarily in oils, her paintings reflect an appreciation for the beauty
          found in everyday moments, natural forms, and changing light.
        </p>
        <a href="/about" class="btn artist-intro__cta">About the Artist</a>
      </div>
    </div>
  </section>

  <section class="section featured-section">
    <div class="container">
      <header class="featured__header">
        <p class="eyebrow">Latest Paintings</p>
        <h2 class="heading-lg">Selected Works</h2>
      </header>
      <div class="featured__grid">
        {featuredWorks.map((artwork, index) => (
          <ArtworkCard artwork={artwork} index={index + 1} />
        ))}
      </div>
      <p class="featured__more">
        <a href="/gallery" class="link-underline">View full collection</a>
      </p>
    </div>
  </section>

  <NewsletterSignup />
</BaseLayout>

<style>
  .hero {
    padding-block: clamp(3rem, 7vw, 5.5rem) clamp(4.5rem, 10vw, 7.5rem);
  }

  .hero__inner {
    display: grid;
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: center;
  }

  @media (min-width: 960px) {
    .hero__inner {
      grid-template-columns: minmax(0, 1.35fr) minmax(18rem, 0.65fr);
      gap: clamp(4rem, 8vw, 6.5rem);
    }
  }

  .hero__statement {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4.2vw, 3.1rem);
    font-weight: 300;
    line-height: 1.18;
    letter-spacing: 0;
    color: var(--color-accent);
  }

  .hero__rule {
    margin-block: 1.5rem 0;
    margin-inline: 0;
  }

  .hero__lead {
    margin-top: 1.45rem;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 2.25rem;
    margin-top: 2.75rem;
  }

  .hero__secondary {
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .hero__figure {
    aspect-ratio: 4 / 3;
    max-height: min(78vh, 48rem);
    margin: 0;
  }

  .artist-intro {
    border-top: 1px solid var(--color-border);
  }

  .artist-intro__inner {
    display: grid;
    gap: clamp(2rem, 6vw, 4.5rem);
  }

  @media (min-width: 820px) {
    .artist-intro__inner {
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
      align-items: start;
    }
  }

  .artist-intro__heading .eyebrow {
    margin-bottom: 1rem;
  }

  .artist-intro__copy {
    color: var(--color-text-muted);
    line-height: var(--leading-body);
  }

  .artist-intro__copy p + p {
    margin-top: 1.25rem;
  }

  .artist-intro__cta {
    margin-top: 2rem;
  }

  .featured-section {
    background: var(--color-bg-elevated);
    border-block: 1px solid var(--color-border);
  }

  .featured__header {
    text-align: center;
    margin-bottom: clamp(3rem, 6vw, 4.5rem);
  }

  .featured__header .eyebrow {
    margin-bottom: 1rem;
  }

  .featured__grid {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4rem);
  }

  @media (min-width: 700px) {
    .featured__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1100px) {
    .featured__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .featured__more {
    margin-top: clamp(3rem, 6vw, 4.5rem);
    text-align: center;
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  @media (max-width: 640px) {
    .hero {
      padding-block: clamp(2.5rem, 10vw, 3.75rem) clamp(3.5rem, 14vw, 5rem);
    }

    .hero__inner {
      gap: 2.5rem;
    }

    .hero__rule {
      margin-block-start: 1.25rem;
    }

    .hero__statement {
      font-size: clamp(2rem, 10vw, 2.75rem);
    }

    .hero__lead {
      margin-top: 1.25rem;
      max-width: 32ch;
    }

    .hero__actions {
      align-items: stretch;
      flex-direction: column;
      gap: 1rem;
      margin-top: 2rem;
      max-width: 18rem;
    }

    .hero__secondary {
      display: inline-flex;
      min-height: 2.75rem;
      align-items: center;
      width: max-content;
    }

    .hero__figure {
      max-height: none;
    }

    .artist-intro__cta {
      max-width: 16rem;
    }

    .featured__header {
      margin-bottom: 2.5rem;
    }

    .featured__grid {
      gap: 2.75rem;
    }

    .featured__more {
      margin-top: 2.5rem;
    }
  }
</style>
