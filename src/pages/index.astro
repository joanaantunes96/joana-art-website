---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArtworkCard from '../components/ArtworkCard.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';
import { featuredWorks, heroImage } from '../data/artworks';
---

<BaseLayout title="Home">
  <section class="hero">
    <div class="hero__inner container">
      <div class="hero__content">
        <h1 class="hero__statement">Contemporary Fine Art</h1>
        <div class="divider hero__rule" aria-hidden="true"></div>
        <p class="lead hero__lead">
          Original oil paintings inspired by the beauty found in the natural world.
        </p>
        <p class="lead hero__lead">
          A collection of work shaped by light, atmosphere, and the moments that feel
          worth holding onto.
        </p>
        <div class="hero__actions">
          <a href="/gallery" class="btn">View Gallery</a>
          <a href="/collectors-list" class="link-underline hero__secondary">Join Collectors' List</a>
          <a href="/contact" class="link-underline hero__secondary">Enquire</a>
        </div>
      </div>
      <figure class="hero__figure image-frame">
        <img
          src={heroImage}
          alt="Featured contemporary artwork by Joana Antunes"
          width="1080"
          height="810"
          fetchpriority="high"
        />
      </figure>
    </div>
  </section>

  <section class="section featured-section">
    <div class="container">
      <header class="featured__header">
        <p class="eyebrow">Latest Work</p>
        <h2 class="heading-lg">Available and recent paintings</h2>
        <p class="featured__intro">
          A first look at recent pieces from the studio. For availability, commissions,
          or to ask about a work, please get in touch.
        </p>
      </header>
      <div class="featured__grid">
        {featuredWorks.map((artwork, index) => (
          <ArtworkCard artwork={artwork} index={index + 1} />
        ))}
      </div>
      <p class="featured__more">
        <a href="/gallery" class="link-underline">View full collection</a>
      </p>
    </div>
  </section>

  <section class="collector-paths section">
    <div class="container collector-paths__inner">
      <header class="collector-paths__header">
        <p class="eyebrow">For Collectors</p>
        <h2 class="heading-lg">Ways to follow the work</h2>
      </header>
      <div class="collector-paths__grid">
        <a href="/gallery" class="collector-path">
          <span class="collector-path__label caption">Originals</span>
          <h3 class="collector-path__title">Browse paintings</h3>
          <p>View recent works and studies, with enquiries welcomed for availability.</p>
        </a>
        <a href="/contact" class="collector-path">
          <span class="collector-path__label caption">Commissions</span>
          <h3 class="collector-path__title">Start a conversation</h3>
          <p>For commissions, studio visits, or questions about a particular piece.</p>
        </a>
        <a href="/collectors-list" class="collector-path">
          <span class="collector-path__label caption">Studio Notes</span>
          <h3 class="collector-path__title">Join the collectors' list</h3>
          <p>Hear about new paintings, available work, and occasional studio updates.</p>
        </a>
      </div>
    </div>
  </section>

  <section class="statement section">
    <div class="container statement__inner">
      <div class="divider" aria-hidden="true"></div>
      <blockquote class="statement__quote heading-md">
        &ldquo;Every work you do is a self-portrait, because your paintings always reveal more
        about you than about your subject.&rdquo;
      </blockquote>
      <cite class="statement__cite">&mdash; Richard Schmid</cite>
    </div>
  </section>

  <NewsletterSignup />
</BaseLayout>

<style>
  .hero {
    padding-block: clamp(4rem, 10vw, 7rem) clamp(5rem, 12vw, 9rem);
  }

  .hero__inner {
    display: grid;
    gap: clamp(3rem, 7vw, 5rem);
    align-items: center;
  }

  @media (min-width: 960px) {
    .hero__inner {
      grid-template-columns: 1fr 1.15fr;
      gap: clamp(4rem, 8vw, 7rem);
    }
  }

  .hero__statement {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4.2vw, 3.1rem);
    font-weight: 300;
    line-height: 1.18;
    letter-spacing: 0;
    color: var(--color-accent);
  }

  .hero__rule {
    margin-block: 1.5rem 0;
    margin-inline: 0;
  }

  .hero__lead {
    margin-top: 1.45rem;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 2.25rem;
    margin-top: 2.75rem;
  }

  .hero__secondary {
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .hero__figure {
    aspect-ratio: 4 / 3;
    max-height: min(72vh, 42rem);
    margin: 0;
  }

  .featured-section {
    background: var(--color-bg-elevated);
    border-block: 1px solid var(--color-border);
  }

  .featured__header {
    text-align: center;
    margin-bottom: clamp(3rem, 6vw, 4.5rem);
  }

  .featured__header .eyebrow {
    margin-bottom: 1rem;
  }

  .featured__intro {
    max-width: 42rem;
    margin: 1.15rem auto 0;
    color: var(--color-text-muted);
    line-height: var(--leading-body);
  }

  .featured__grid {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4rem);
  }

  @media (min-width: 700px) {
    .featured__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1100px) {
    .featured__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .featured__more {
    margin-top: clamp(3rem, 6vw, 4.5rem);
    text-align: center;
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .collector-paths {
    background: var(--color-bg);
  }

  .collector-paths__inner {
    display: grid;
    gap: clamp(2.75rem, 6vw, 4.5rem);
  }

  @media (min-width: 920px) {
    .collector-paths__inner {
      grid-template-columns: minmax(0, 0.75fr) minmax(0, 1.25fr);
      align-items: start;
    }
  }

  .collector-paths__header .eyebrow {
    margin-bottom: 1rem;
  }

  .collector-paths__grid {
    display: grid;
    gap: 1px;
    border-block: 1px solid var(--color-border);
  }

  .collector-path {
    display: grid;
    gap: 0.65rem;
    padding-block: clamp(1.5rem, 3vw, 2rem);
    border-bottom: 1px solid var(--color-border);
    transition: color var(--transition);
  }

  .collector-path:last-child {
    border-bottom: none;
  }

  .collector-path:hover,
  .collector-path:focus-visible {
    color: var(--color-accent);
  }

  .collector-path__label {
    color: var(--color-text-faint);
  }

  .collector-path__title {
    font-family: var(--font-display);
    font-size: clamp(1.45rem, 2.4vw, 1.9rem);
    font-weight: 400;
    line-height: 1.18;
  }

  .collector-path p {
    max-width: 38rem;
    color: var(--color-text-muted);
    line-height: var(--leading-body);
  }

  .statement__inner {
    text-align: center;
    max-width: 48rem;
    margin-inline: auto;
  }

  .statement__inner .divider {
    margin-bottom: 2.5rem;
  }

  .statement__quote {
    font-style: italic;
    font-weight: 400;
    line-height: 1.5;
    color: var(--color-text);
  }

  .statement__cite {
    display: block;
    margin-top: 1.75rem;
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--color-text-faint);
    font-style: normal;
  }

  @media (max-width: 640px) {
    .hero {
      padding-block: clamp(3rem, 12vw, 4.25rem) clamp(3.5rem, 14vw, 5rem);
    }

    .hero__inner {
      gap: 2.5rem;
    }

    .hero__rule {
      margin-block-start: 1.25rem;
    }

    .hero__statement {
      font-size: clamp(2rem, 10vw, 2.75rem);
    }

    .hero__lead {
      margin-top: 1.25rem;
      max-width: 32ch;
    }

    .hero__actions {
      align-items: stretch;
      flex-direction: column;
      gap: 1rem;
      margin-top: 2rem;
      max-width: 18rem;
    }

    .hero__secondary {
      display: inline-flex;
      min-height: 2.75rem;
      align-items: center;
      width: max-content;
    }

    .hero__figure {
      max-height: none;
    }

    .featured__header {
      margin-bottom: 2.5rem;
    }

    .featured__intro {
      margin-top: 1rem;
    }

    .featured__grid {
      gap: 2.75rem;
    }

    .featured__more {
      margin-top: 2.5rem;
    }

    .collector-path {
      padding-block: 1.35rem;
    }

    .statement__inner .divider {
      margin-bottom: 2rem;
    }

    .statement__quote {
      font-size: clamp(1.55rem, 8vw, 2rem);
      line-height: 1.42;
    }
  }
</style>
