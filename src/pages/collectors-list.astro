---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Join the Collectors’ List"
  description="Join Joana Antunes' collectors list for new paintings, available works, studio updates, and occasional giveaways."
>
  <section class="collectors section">
    <div class="container collectors__inner">
      <div class="collectors__copy">
        <p class="eyebrow">Studio Notes</p>
        <h1 class="heading-xl collectors__title">Join the Collectors’ List</h1>
        <div class="divider collectors__rule" aria-hidden="true"></div>
        <p class="lead collectors__intro">
          Be the first to hear about new paintings, available works, studio updates,
          and occasional giveaways.
        </p>
      </div>

      <form
        class="collectors__form"
        action="https://formspree.io/f/mdajnyon"
        method="POST"
        data-collectors-form
      >
        <input type="hidden" name="form-type" value="collectors-list" />
        <div class="field">
          <label class="caption" for="collectors-first-name">First name <span>(optional)</span></label>
          <input
            type="text"
            id="collectors-first-name"
            name="first-name"
            autocomplete="given-name"
          />
        </div>
        <div class="field">
          <label class="caption" for="collectors-email">Email</label>
          <input
            type="email"
            id="collectors-email"
            name="email"
            required
            autocomplete="email"
          />
        </div>
        <button type="submit" class="btn">Join the list</button>
        <p class="collectors__status caption" data-collectors-status aria-live="polite">
          Your details will be sent securely via Formspree.
        </p>
      </form>

      <a href="/" class="link-underline collectors__home">Back to homepage</a>
    </div>
  </section>
</BaseLayout>

<script>
  const form = document.querySelector('[data-collectors-form]');
  const status = document.querySelector('[data-collectors-status]');

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();

    if (!(form instanceof HTMLFormElement) || !(status instanceof HTMLElement)) return;

    const submitButton = form.querySelector('button[type="submit"]');
    const originalButtonText = submitButton?.textContent ?? 'Join the list';

    status.textContent = 'Adding you to the list...';
    submitButton?.setAttribute('disabled', '');

    try {
      const response = await fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        headers: {
          Accept: 'application/json',
        },
      });

      if (!response.ok) throw new Error('Collectors list signup failed');

      form.reset();
      status.textContent = "Thank you — you're on the collectors' list.";
    } catch {
      status.textContent = 'Something went wrong. Please try again later.';
    } finally {
      submitButton?.removeAttribute('disabled');
      if (submitButton) submitButton.textContent = originalButtonText;
    }
  });
</script>

<style>
  .collectors {
    min-height: calc(100vh - var(--header-height));
    display: flex;
    align-items: center;
  }

  .collectors__inner {
    max-width: 50rem;
    margin-inline: auto;
  }

  .collectors__copy {
    text-align: center;
  }

  .collectors__title {
    margin-top: 0.75rem;
    font-size: clamp(3rem, 7vw, 4.75rem);
    font-weight: 300;
  }

  .collectors__rule {
    margin-block: 1.5rem 0;
  }

  .collectors__intro {
    margin: 1.5rem auto 0;
    max-width: 46rem;
  }

  .collectors__form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin-top: clamp(2.25rem, 5vw, 3rem);
    padding: clamp(2rem, 4vw, 2.75rem);
    border: 1px solid var(--color-border);
    background: var(--color-bg-elevated);
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .field label {
    color: var(--color-text-faint);
  }

  .field label span {
    letter-spacing: 0.08em;
    text-transform: none;
  }

  .field input {
    width: 100%;
    min-height: 3rem;
    padding: 0.9rem 1rem;
    border: 1px solid var(--color-border);
    background: var(--color-bg);
    color: var(--color-text);
    font-family: var(--font-body);
    font-size: 1rem;
    transition:
      border-color var(--transition),
      box-shadow var(--transition);
  }

  .field input:hover {
    border-color: var(--color-border-strong);
  }

  .field input:focus {
    outline: none;
    border-color: var(--color-accent);
    box-shadow: 0 0 0 1px var(--color-accent);
  }

  .collectors__status {
    color: var(--color-text-faint);
    line-height: 1.55;
  }

  .collectors__home {
    display: block;
    width: max-content;
    margin: 2rem auto 0;
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  @media (max-width: 640px) {
    .collectors {
      align-items: start;
    }

    .collectors__title {
      margin-top: 0.5rem;
      font-size: clamp(2.65rem, 13vw, 3.75rem);
    }

    .collectors__intro {
      margin-top: 1.25rem;
      max-width: 30ch;
    }

    .collectors__form {
      gap: 1rem;
      padding: 1.35rem;
    }
  }
</style>
