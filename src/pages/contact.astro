---
import BaseLayout from '../layouts/BaseLayout.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';
---

<BaseLayout
  title="Contact"
  description="Commission inquiries, studio visits, and press - get in touch with Joana Antunes."
>
  <section class="contact section">
    <div class="container contact__grid">
      <div class="contact__intro">
        <p class="eyebrow">Inquiries</p>
        <h1 class="heading-xl contact__title">Contact</h1>
        <div class="divider contact__rule" aria-hidden="true"></div>
        <p class="lead contact__lead">
          For commissions, availability, or studio visits, please reach out. I will aim to
          respond within two business days.
        </p>

        <div class="contact__details">
          <div class="contact__item">
            <span class="contact__label caption">Email</span>
            <a href="mailto:joanarfa@gmail.com" class="contact__value link-underline"
              >joanarfa@gmail.com</a
            >
          </div>
          <div class="contact__item">
            <span class="contact__label caption">Location</span>
            <p class="contact__value">Devon, UK</p>
          </div>
          <div class="contact__item">
            <span class="contact__label caption">Instagram</span>
            <a
              href="https://instagram.com/joanaantunes_art"
              class="contact__value link-underline"
              target="_blank"
              rel="noopener noreferrer">@joanaantunes_art</a
            >
          </div>
        </div>
      </div>

      <form class="contact__form" action="https://formspree.io/f/mdajnyon" method="POST" data-contact-form>
        <input type="hidden" name="_subject" value="New portfolio inquiry" />
        <div class="field">
          <label class="caption" for="name">Name</label>
          <input type="text" id="name" name="name" required autocomplete="name" />
        </div>
        <div class="field">
          <label class="caption" for="email">Email</label>
          <input type="email" id="email" name="email" required autocomplete="email" />
        </div>
        <div class="field">
          <label class="caption" for="subject">Subject</label>
          <select id="subject" name="subject">
            <option value="commission">Commission</option>
            <option value="purchase">Purchase inquiry</option>
            <option value="press">Press</option>
            <option value="other">Other</option>
          </select>
        </div>
        <div class="field">
          <label class="caption" for="message">Message</label>
          <textarea id="message" name="message" rows="5" required></textarea>
        </div>
        <button type="submit" class="btn">Send message</button>
        <p class="contact__note caption" data-form-status aria-live="polite">
          Your inquiry will be sent securely via Formspree.
        </p>
      </form>
    </div>
  </section>

  <NewsletterSignup compact />
</BaseLayout>

<script>
  const form = document.querySelector('[data-contact-form]');
  const status = document.querySelector('[data-form-status]');

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();

    if (!(form instanceof HTMLFormElement) || !(status instanceof HTMLElement)) return;

    const submitButton = form.querySelector('button[type="submit"]');
    const originalButtonText = submitButton?.textContent ?? 'Send message';

    status.textContent = 'Sending your message...';
    submitButton?.setAttribute('disabled', '');

    try {
      const response = await fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        headers: {
          Accept: 'application/json',
        },
      });

      if (!response.ok) throw new Error('Form submission failed');

      form.reset();
      status.textContent = 'Thank you. Your message has been sent.';
    } catch {
      status.textContent = 'Something went wrong. Please try again or email joanarfa@gmail.com.';
    } finally {
      submitButton?.removeAttribute('disabled');
      if (submitButton) submitButton.textContent = originalButtonText;
    }
  });
</script>

<style>
  .contact__grid {
    display: grid;
    gap: clamp(4rem, 8vw, 6rem);
    align-items: start;
  }

  @media (min-width: 960px) {
    .contact__grid {
      grid-template-columns: 1fr 1fr;
      gap: clamp(4rem, 10vw, 8rem);
    }
  }

  .contact__title {
    font-weight: 300;
    margin-top: 0.5rem;
  }

  .contact__rule {
    margin-block: 1.75rem 0;
    margin-inline: 0;
  }

  .contact__lead {
    margin-top: 1.5rem;
  }

  .contact__details {
    margin-top: 3rem;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .contact__label {
    display: block;
    margin-bottom: 0.5rem;
    color: var(--color-text-faint);
  }

  .contact__value {
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 400;
    line-height: 1.3;
  }

  .contact__form {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    padding: clamp(2.25rem, 4vw, 3rem);
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .field label {
    color: var(--color-text-faint);
  }

  .field input,
  .field select,
  .field textarea {
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: 400;
    padding: 0.9rem 1rem;
    border: 1px solid var(--color-border);
    background: var(--color-bg);
    color: var(--color-text);
    transition:
      border-color var(--transition),
      box-shadow var(--transition);
  }

  .field input:hover,
  .field select:hover,
  .field textarea:hover {
    border-color: var(--color-border-strong);
  }

  .field input:focus,
  .field select:focus,
  .field textarea:focus {
    outline: none;
    border-color: var(--color-accent);
    box-shadow: 0 0 0 1px var(--color-accent);
  }

  .field textarea {
    resize: vertical;
    min-height: 9rem;
    line-height: var(--leading-body);
  }

  .contact__note {
    color: var(--color-text-faint);
    margin-top: -0.25rem;
  }

  @media (max-width: 640px) {
    .contact__grid {
      gap: 2.75rem;
    }

    .contact__title {
      margin-top: 0.35rem;
    }

    .contact__rule {
      margin-block-start: 1.25rem;
    }

    .contact__lead {
      margin-top: 1.25rem;
      max-width: 34rem;
    }

    .contact__details {
      gap: 1.4rem;
      margin-top: 2.25rem;
    }

    .contact__value {
      font-size: 1.2rem;
      overflow-wrap: anywhere;
    }

    .contact__form {
      gap: 1.25rem;
      padding: 1.35rem;
    }

    .field {
      gap: 0.5rem;
    }

    .field input,
    .field select,
    .field textarea {
      min-height: 3rem;
      font-size: 1rem;
      padding: 0.85rem 0.9rem;
    }

    .field textarea {
      min-height: 8rem;
    }

    .contact__note {
      line-height: 1.55;
    }
  }
</style>
