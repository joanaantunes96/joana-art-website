---
import type { Artwork } from '../data/artworks';

interface Props {
  works: Artwork[];
}

const { works } = Astro.props;
---

<dialog class="lightbox" id="gallery-lightbox" aria-label="Image viewer">
  <div class="lightbox__backdrop" data-close></div>
  <div class="lightbox__panel">
    <header class="lightbox__header">
      <div class="lightbox__meta">
        <p class="lightbox__title" id="lightbox-title"></p>
        <p class="lightbox__details" id="lightbox-details"></p>
      </div>
      <div class="lightbox__actions">
        <button type="button" class="lightbox__btn" id="lightbox-zoom-out" aria-label="Zoom out">−</button>
        <span class="lightbox__zoom-level" id="lightbox-zoom-level" aria-live="polite">100%</span>
        <button type="button" class="lightbox__btn" id="lightbox-zoom-in" aria-label="Zoom in">+</button>
        <button type="button" class="lightbox__btn lightbox__btn--reset" id="lightbox-zoom-reset" aria-label="Reset zoom">
          Reset
        </button>
        <button type="button" class="lightbox__btn lightbox__btn--close" data-close aria-label="Close viewer">
          Close
        </button>
      </div>
    </header>

    <div class="lightbox__stage" id="lightbox-stage">
      <button type="button" class="lightbox__nav lightbox__nav--prev" id="lightbox-prev" aria-label="Previous image">
        ‹
      </button>
      <div class="lightbox__viewport" id="lightbox-viewport">
        <img class="lightbox__image" id="lightbox-image" alt="" draggable="false" />
      </div>
      <button type="button" class="lightbox__nav lightbox__nav--next" id="lightbox-next" aria-label="Next image">
        ›
      </button>
    </div>

    <p class="lightbox__hint">Scroll or pinch to zoom · Drag to pan · Esc to close</p>
  </div>
</dialog>

<script define:vars={{ works }}>
  const dialog = document.getElementById('gallery-lightbox');
  const image = document.getElementById('lightbox-image');
  const titleEl = document.getElementById('lightbox-title');
  const detailsEl = document.getElementById('lightbox-details');
  const zoomLevelEl = document.getElementById('lightbox-zoom-level');
  const viewport = document.getElementById('lightbox-viewport');
  const stage = document.getElementById('lightbox-stage');

  if (!dialog || !image || !viewport || !stage) throw new Error('Lightbox elements missing');

  let currentIndex = 0;
  let scale = 1;
  let translateX = 0;
  let translateY = 0;
  let isDragging = false;
  let dragStartX = 0;
  let dragStartY = 0;
  let translateStartX = 0;
  let translateStartY = 0;

  const MIN_SCALE = 1;
  const MAX_SCALE = 4;

  function clamp(value, min, max) {
    return Math.min(max, Math.max(min, value));
  }

  function applyTransform() {
    image.style.transform = `translate(${translateX}px, ${translateY}px) scale(${scale})`;
    zoomLevelEl.textContent = `${Math.round(scale * 100)}%`;
    viewport.classList.toggle('is-zoomed', scale > 1);
  }

  function resetTransform() {
    scale = 1;
    translateX = 0;
    translateY = 0;
    applyTransform();
  }

  function setZoom(nextScale, originX, originY) {
    const prev = scale;
    scale = clamp(nextScale, MIN_SCALE, MAX_SCALE);

    if (scale === 1) {
      translateX = 0;
      translateY = 0;
    } else if (originX != null && originY != null && prev !== scale) {
      const rect = viewport.getBoundingClientRect();
      const ox = originX - rect.left - rect.width / 2;
      const oy = originY - rect.top - rect.height / 2;
      const ratio = scale / prev - 1;
      translateX -= ox * ratio;
      translateY -= oy * ratio;
    }

    applyTransform();
  }

  function loadWork(index) {
    const work = works[index];
    if (!work) return;
    currentIndex = index;
    image.src = work.image;
    image.alt = work.title;
    titleEl.textContent = work.title;
    detailsEl.textContent = `${work.medium} · ${work.year}`;
    resetTransform();
  }

  function open(index) {
    loadWork(index);
    dialog.showModal();
    document.body.classList.add('lightbox-open');
  }

  function close() {
    dialog.close();
    document.body.classList.remove('lightbox-open');
    resetTransform();
  }

  function showNext(delta) {
    const next = (currentIndex + delta + works.length) % works.length;
    loadWork(next);
  }

  document.querySelectorAll('[data-lightbox-index]').forEach((trigger) => {
    trigger.addEventListener('click', () => {
      const index = Number(trigger.getAttribute('data-lightbox-index'));
      if (!Number.isNaN(index)) open(index);
    });
  });

  dialog.querySelectorAll('[data-close]').forEach((el) => {
    el.addEventListener('click', close);
  });

  document.getElementById('lightbox-prev')?.addEventListener('click', () => showNext(-1));
  document.getElementById('lightbox-next')?.addEventListener('click', () => showNext(1));
  document.getElementById('lightbox-zoom-in')?.addEventListener('click', () => setZoom(scale + 0.5));
  document.getElementById('lightbox-zoom-out')?.addEventListener('click', () => setZoom(scale - 0.5));
  document.getElementById('lightbox-zoom-reset')?.addEventListener('click', resetTransform);

  dialog.addEventListener('cancel', (e) => {
    e.preventDefault();
    close();
  });

  dialog.addEventListener('click', (e) => {
    if (e.target === dialog) close();
  });

  document.addEventListener('keydown', (e) => {
    if (!dialog.open) return;
    if (e.key === 'Escape') close();
    if (e.key === 'ArrowRight') showNext(1);
    if (e.key === 'ArrowLeft') showNext(-1);
    if (e.key === '+' || e.key === '=') setZoom(scale + 0.25);
    if (e.key === '-') setZoom(scale - 0.25);
  });

  viewport.addEventListener(
    'wheel',
    (e) => {
      if (!dialog.open) return;
      e.preventDefault();
      const delta = e.deltaY < 0 ? 0.2 : -0.2;
      setZoom(scale + delta, e.clientX, e.clientY);
    },
    { passive: false },
  );

  image.addEventListener('dblclick', (e) => {
    if (scale > 1) resetTransform();
    else setZoom(2, e.clientX, e.clientY);
  });

  viewport.addEventListener('pointerdown', (e) => {
    if (scale <= 1 || e.button !== 0) return;
    isDragging = true;
    dragStartX = e.clientX;
    dragStartY = e.clientY;
    translateStartX = translateX;
    translateStartY = translateY;
    viewport.setPointerCapture(e.pointerId);
    viewport.classList.add('is-dragging');
  });

  viewport.addEventListener('pointermove', (e) => {
    if (!isDragging) return;
    translateX = translateStartX + (e.clientX - dragStartX);
    translateY = translateStartY + (e.clientY - dragStartY);
    applyTransform();
  });

  function endDrag(e) {
    if (!isDragging) return;
    isDragging = false;
    viewport.classList.remove('is-dragging');
    try {
      viewport.releasePointerCapture(e.pointerId);
    } catch {
      /* ignore */
    }
  }

  viewport.addEventListener('pointerup', endDrag);
  viewport.addEventListener('pointercancel', endDrag);

  let pinchStartDistance = 0;
  let pinchStartScale = 1;

  viewport.addEventListener(
    'touchstart',
    (e) => {
      if (e.touches.length === 2) {
        const [a, b] = [e.touches[0], e.touches[1]];
        pinchStartDistance = Math.hypot(b.clientX - a.clientX, b.clientY - a.clientY);
        pinchStartScale = scale;
      }
    },
    { passive: true },
  );

  viewport.addEventListener(
    'touchmove',
    (e) => {
      if (e.touches.length !== 2) return;
      e.preventDefault();
      const [a, b] = [e.touches[0], e.touches[1]];
      const distance = Math.hypot(b.clientX - a.clientX, b.clientY - a.clientY);
      const midX = (a.clientX + b.clientX) / 2;
      const midY = (a.clientY + b.clientY) / 2;
      if (pinchStartDistance > 0) {
        setZoom(pinchStartScale * (distance / pinchStartDistance), midX, midY);
      }
    },
    { passive: false },
  );
</script>

<style>
  .lightbox {
    width: 100vw;
    max-width: 100vw;
    height: 100vh;
    max-height: 100vh;
    margin: 0;
    padding: 0;
    border: none;
    background: transparent;
    overflow: hidden;
  }

  .lightbox::backdrop {
    background: rgba(36, 31, 28, 0.93);
    backdrop-filter: blur(8px);
  }

  .lightbox__backdrop {
    position: fixed;
    inset: 0;
    z-index: -1;
  }

  .lightbox__panel {
    display: flex;
    flex-direction: column;
    height: 100%;
    color: #fbf7ee;
  }

  .lightbox__header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 1.25rem;
    border-bottom: 1px solid rgba(251, 247, 238, 0.14);
  }

  .lightbox__title {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 400;
  }

  .lightbox__details {
    font-size: 0.8rem;
    color: rgba(251, 247, 238, 0.68);
    margin-top: 0.2rem;
  }

  .lightbox__actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .lightbox__btn {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    padding: 0.5rem 0.75rem;
    border: 1px solid rgba(251, 247, 238, 0.28);
    background: transparent;
    color: inherit;
    cursor: pointer;
    transition:
      background var(--transition),
      border-color var(--transition);
  }

  .lightbox__btn:hover,
  .lightbox__btn:focus-visible {
    background: rgba(168, 135, 79, 0.16);
    border-color: rgba(168, 135, 79, 0.55);
  }

  .lightbox__zoom-level {
    min-width: 3rem;
    text-align: center;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    color: rgba(251, 247, 238, 0.76);
  }

  .lightbox__stage {
    position: relative;
    flex: 1;
    display: flex;
    align-items: center;
    min-height: 0;
  }

  .lightbox__viewport {
    flex: 1;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    touch-action: none;
    cursor: zoom-in;
  }

  .lightbox__viewport.is-zoomed {
    cursor: grab;
  }

  .lightbox__viewport.is-dragging {
    cursor: grabbing;
  }

  .lightbox__image {
    max-width: min(92vw, 1200px);
    max-height: calc(100vh - 8rem);
    width: auto;
    height: auto;
    object-fit: contain;
    transform-origin: center center;
    transition: transform 0.08s linear;
    user-select: none;
    will-change: transform;
  }

  .lightbox__nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 2;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid rgba(251, 247, 238, 0.22);
    border-radius: 50%;
    background: rgba(36, 31, 28, 0.55);
    color: #fbf7ee;
    font-size: 1.75rem;
    line-height: 1;
    cursor: pointer;
    transition: background var(--transition);
  }

  .lightbox__nav:hover {
    background: rgba(168, 135, 79, 0.18);
  }

  .lightbox__nav--prev {
    left: 0.75rem;
  }

  .lightbox__nav--next {
    right: 0.75rem;
  }

  .lightbox__hint {
    padding: 0.65rem 1.25rem 1rem;
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-align: center;
    color: rgba(251, 247, 238, 0.48);
  }

  :global(body.lightbox-open) {
    overflow: hidden;
  }

  @media (max-width: 640px) {
    .lightbox__nav {
      width: 2.25rem;
      height: 2.25rem;
      font-size: 1.4rem;
    }

    .lightbox__btn--reset {
      display: none;
    }
  }
</style>
