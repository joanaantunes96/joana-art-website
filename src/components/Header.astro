---
const navItems = [
  { href: '/', label: 'Home' },
  { href: '/gallery', label: 'Gallery' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];

const currentPath = Astro.url.pathname;
---

<header class="header">
  <div class="header__inner container">
    <a href="/" class="header__logo" aria-label="Joana Antunes Fine Art — Home">
      <span class="header__wordmark">
        <span class="header__name">Joana Antunes</span>
        <span class="header__descriptor">Fine Art</span>
      </span>
    </a>

    <button
      type="button"
      class="header__toggle"
      aria-expanded="false"
      aria-controls="site-nav"
      aria-label="Toggle menu"
    >
      <span class="header__toggle-bar"></span>
      <span class="header__toggle-bar"></span>
    </button>

    <nav id="site-nav" class="header__nav" aria-label="Main">
      <ul class="header__list">
        {
          navItems.map(({ href, label }) => (
            <li>
              <a
                href={href}
                class:list={['header__link', { 'is-active': currentPath === href }]}
              >
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector('.header__toggle');
  const nav = document.querySelector('.header__nav');

  toggle?.addEventListener('click', () => {
    const expanded = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!expanded));
    document.body.classList.toggle('nav-open', !expanded);
  });

  nav?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      toggle?.setAttribute('aria-expanded', 'false');
      document.body.classList.remove('nav-open');
    });
  });
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 100;
    height: var(--header-height);
    background: rgba(251, 247, 238, 0.9);
    backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--color-border);
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--header-height);
  }

  .header__logo {
    display: flex;
    align-items: center;
    transition: opacity var(--transition);
  }

  .header__logo:hover {
    opacity: 0.75;
  }

  .header__wordmark {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    line-height: 1.15;
  }

  .header__name {
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 2.5vw, 1.35rem);
    font-weight: 400;
    letter-spacing: 0.02em;
    color: var(--color-text);
  }

  .header__descriptor {
    font-family: var(--font-body);
    font-size: 0.62rem;
    font-weight: 400;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .header__list {
    display: flex;
    gap: clamp(1.5rem, 4vw, 2.75rem);
    list-style: none;
  }

  .header__link {
    position: relative;
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    transition: color var(--transition);
  }

  .header__link::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -4px;
    width: 100%;
    height: 1px;
    background: var(--color-accent);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform var(--transition);
  }

  .header__link:hover,
  .header__link.is-active {
    color: var(--color-text);
  }

  .header__link:hover::after,
  .header__link.is-active::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .header__toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 6px;
    width: 2rem;
    height: 2rem;
    padding: 0;
    border: none;
    background: none;
    cursor: pointer;
  }

  .header__toggle-bar {
    display: block;
    width: 100%;
    height: 1px;
    background: var(--color-accent);
    transition:
      transform var(--transition),
      opacity var(--transition);
  }

  :global(body.nav-open) .header__toggle-bar:first-child {
    transform: translateY(3.5px) rotate(45deg);
  }

  :global(body.nav-open) .header__toggle-bar:last-child {
    transform: translateY(-3.5px) rotate(-45deg);
  }

  @media (max-width: 768px) {
    .header__toggle {
      display: flex;
      width: 2.75rem;
      height: 2.75rem;
      align-items: center;
    }

    .header__nav {
      position: fixed;
      inset: var(--header-height) 0 0 0;
      display: flex;
      align-items: center;
      justify-content: center;
      background: var(--color-bg);
      min-height: calc(100vh - var(--header-height));
      opacity: 0;
      visibility: hidden;
      transition:
        opacity var(--transition),
        visibility var(--transition);
    }

    :global(body.nav-open) .header__nav {
      opacity: 1;
      visibility: visible;
    }

    .header__list {
      flex-direction: column;
      align-items: center;
      gap: 0.75rem;
      width: min(100% - 3rem, 18rem);
    }

    .header__list li {
      width: 100%;
    }

    .header__link {
      display: flex;
      justify-content: center;
      width: 100%;
      min-height: 3rem;
      align-items: center;
      font-size: 0.85rem;
    }
  }
</style>
